# Optional: NVIDIA NIM free endpoint (human answers). Leave empty = local FAQ only.
# Get key: https://build.nvidia.com → Generate API Key (nvapi-...)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# TTS: edge (default) | fish
TTS_PROVIDER=edge
EDGE_VOICE_EL=el-GR-AthinaNeural
EDGE_VOICE_EN=en-US-JennyNeural

# Optional Fish Audio — STT and/or TTS if TTS_PROVIDER=fish
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_TTS_MODEL=s2.1-pro-free

# Admin
ADMIN_SECRET=change-me

# Site
SITE_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

DEMO_MODE=false
