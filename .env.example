# Required — NVIDIA NIM full AI assistant
# https://build.nvidia.com → Generate API Key
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Fast chat model for voice. Override if needed.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# TTS: Greek + English both use Fish Audio voices
TTS_PROVIDER=fish
EDGE_VOICE_EL=el-GR-AthinaNeural
EDGE_VOICE_EN=en-US-AvaMultilingualNeural

# Fish Audio STT + TTS (Greek default, English optional)
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_REFERENCE_ID_EN=
FISH_TTS_MODEL=s2.1-pro-free

ADMIN_SECRET=change-me
SITE_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false
