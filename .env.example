# Required — NVIDIA NIM full AI assistant
# https://build.nvidia.com → Generate API Key
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# TTS: Greek → Fish (reference_id); English → Edge Ava Multilingual
TTS_PROVIDER=auto
EDGE_VOICE_EL=el-GR-AthinaNeural
EDGE_VOICE_EN=en-US-AvaMultilingualNeural

# Optional Fish Audio STT
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_TTS_MODEL=s2.1-pro-free

ADMIN_SECRET=change-me
SITE_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false
